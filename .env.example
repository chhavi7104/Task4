# ==========================================================
# Web Crawler & Data Extraction Engine - Environment Config
# Copy this file to `.env` and adjust values as needed.
# ==========================================================

# Comma-separated seed URLs to start crawling from
SEED_URLS=https://example.com

# Maximum recursion depth for internal link following
MAX_DEPTH=2

# Maximum number of pages to crawl in a single run (safety cap)
MAX_PAGES=100

# Delay (in seconds) between requests to the same host
REQUEST_DELAY=1.0

# Request timeout in seconds
REQUEST_TIMEOUT=10

# Number of retry attempts for failed requests
MAX_RETRIES=3

# Backoff factor (seconds) multiplied between retries
RETRY_BACKOFF=1.5

# Whether to respect robots.txt (true/false)
RESPECT_ROBOTS_TXT=true

# User-Agent string sent with every request
USER_AGENT=EduCrawlerBot/1.0 (+https://github.com/yourname/webcrawler)

# Use asynchronous crawler (true) or synchronous (false)
USE_ASYNC=true

# Concurrency limit for async crawling
CONCURRENCY=5

# Output directory for exports
OUTPUT_DIR=exports

# Export formats: comma-separated (json,csv,sqlite)
EXPORT_FORMATS=json,csv,sqlite

# Log file path
LOG_FILE=logs/crawler.log

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
